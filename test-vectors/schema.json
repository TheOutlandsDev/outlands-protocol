{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outlands.invalid/schemas/out-consensus-v0-test-vector.schema.json",
  "title": "OUT Consensus v0 test vector",
  "description": "Schema for positive, negative, placeholder, computed, and independently verified OUT vectors. The .invalid domain is intentional and non-resolving.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "id",
    "kind",
    "status",
    "description",
    "spec_refs",
    "inputs",
    "expected",
    "verification"
  ],
  "properties": {
    "format_version": { "const": 0 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "kind": {
      "enum": [
        "canonical_transaction_encoding",
        "transaction_signing_preimage",
        "transaction_id",
        "address_encoding_decoding",
        "block_header_encoding",
        "pow_preimage_target",
        "transaction_merkle_root",
        "account_state_transition",
        "state_root",
        "invalid_noncanonical_encoding",
        "overflow_or_nonce_failure",
        "cross_network_replay_rejection"
      ]
    },
    "status": { "enum": ["placeholder", "computed", "independently_verified"] },
    "description": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "spec_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "parameters": {
      "type": "object",
      "description": "Exact ratified parameter values or symbolic ${P_*} placeholders.",
      "additionalProperties": { "$ref": "#/$defs/json_value" }
    },
    "inputs": {
      "type": "object",
      "description": "Inputs. Hex strings must be lowercase, even-length, and have no 0x prefix when the field name ends in _hex.",
      "additionalProperties": { "$ref": "#/$defs/json_value" }
    },
    "expected": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/expected_value" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "implementations"],
      "properties": {
        "method": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "implementations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "language", "version", "result_digest"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 128 },
              "language": { "type": "string", "minLength": 1, "maxLength": 64 },
              "version": { "type": "string", "minLength": 1, "maxLength": 128 },
              "result_digest": { "oneOf": [{ "$ref": "#/$defs/hex" }, { "type": "null" }] }
            }
          }
        },
        "notes": { "type": "string", "maxLength": 4096 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "placeholder" } } },
      "then": { "properties": { "verification": { "properties": { "implementations": { "maxItems": 0 } } } } }
    },
    {
      "if": { "properties": { "status": { "const": "computed" } } },
      "then": { "properties": { "verification": { "properties": { "implementations": { "minItems": 1 } } } } }
    },
    {
      "if": { "properties": { "status": { "const": "independently_verified" } } },
      "then": { "properties": { "verification": { "properties": { "implementations": { "minItems": 2 } } } } }
    }
  ],
  "$defs": {
    "hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$" },
    "json_value": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "integer" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/json_value" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/json_value" } }
      ]
    },
    "expected_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "value", "verification"],
      "properties": {
        "encoding": { "enum": ["hex", "bech32m", "decimal_string", "integer", "boolean", "error_code", "object"] },
        "value": { "$ref": "#/$defs/json_value" },
        "verification": { "enum": ["placeholder", "computed", "independently_verified"] },
        "notes": { "type": "string", "maxLength": 2048 }
      }
    }
  }
}
